########################################################################
# Generic CLK(00 to 23) Register (1 to 16 and 25 to 32)

record(longout, "$(P)$(R)CLK$(num)Channel-SP") {
  field(DESC, "CLK$(num) event code")
  field(DRVH, "2")
  field(DRVL, "0")
  field(DTYP, "stream")
  field(OUT, "@timing.proto evre_clk_set($(P),$(R),$(num)) $(PORT)")
}

record(longin, "$(P)$(R)CLK$(num)Channel-RB") {
  field(ASG, "Reserved")
  field(DESC, "CLK$(num) event RBV")
}

record(longout, "$(P)$(R)CLK$(num)Div-SP"){
  field(VAL, "1")
  field(DESC, "CLK$(num) number of pulses")
  field(DRVH, "65535")
  field(DRVL, "1")
  field(EGU, "pulses")
  field(DTYP, "stream")
  field(OUT, "@timing.proto evre_clk_set($(P),$(R),$(num)) $(PORT)")
}

record(longin, "$(P)$(R)CLK$(num)Div-RB"){
  field(ASG, "Reserved")
  field(DESC, "CLK$(num) number of pulses RBV")
  field(EGU, "pulses")
}

record(ao, "$(P)$(R)CLK$(num)Width-SP") {
  field(DESC, "CLK$(num) trigger width time")
  field(VAL, "0.008")
  field(DRVH, "17000000")
  field(DRVL, "0.008")
  field(PREC, "3")
  field(EGU, "us")
  field(FLNK, "$(P)$(R)CLK$(num)WidthCalc")
}

record(calc, "$(P)$(R)CLK$(num)Width-RB") {
  field(INPA, "$(P)$(R)CLK$(num)WidthRaw-RB")
  field(INPB, "$(P)$(R)FPGAClk-Mon")
  field(PREC, "3")
  field(DESC, "CLK$(num) width time RBV")
  field(EGU, "us")
  field(CALC, "A/B*1000000")
}

record(calcout, "$(P)$(R)CLK$(num)WidthCalc") {
  field(DESC, "CLK$(num) trigger width calc")
  field(INPA, "$(P)$(R)CLK$(num)Width-SP")
  field(INPB, "$(P)$(R)FPGAClk-Mon")
  field(CALC, "CEIL(A*(B/1000000))-A*(B/1000000)<0.5?CEIL(A*(B/1000000)):FLOOR(A*(B/1000000))")
  field(OUT, "$(P)$(R)CLK$(num)WidthRaw-SP PP")
  field(SDIS, "$(P)$(R)CLK$(num)WidthUpdate.PACT")
}

record(longout, "$(P)$(R)CLK$(num)WidthRaw-SP") {
  field(DESC, "CLK$(num) trigger width")
  field(VAL, "1")
  field(DRVH, "2147483647")
  field(DRVL, "1")
  field(EGU, "evt_T")
  field(DTYP, "stream")
  field(OUT, "@timing.proto evre_clk_set($(P),$(R),$(num)) $(PORT)")
}

record(longin, "$(P)$(R)CLK$(num)WidthRaw-RB") {
  field(ASG, "Reserved")
  field(DESC, "CLK$(num) width RBV")
  field(EGU, "evt_T")
  field(FLNK, "$(P)$(R)CLK$(num)Width-RB")
}

record(calcout, "$(P)$(R)CLK$(num)WidthUpdate") {
  field(DESC, "CLK$(num) trigger width update")
  field(INPA, "$(P)$(R)CLK$(num)WidthRaw-SP")
  field(INPB, "$(P)$(R)FPGAClk-Mon CPP")
  field(CALC, "A/B*1000000")
  field(OUT, "$(P)$(R)CLK$(num)Width-SP PP")
}

record(ao, "$(P)$(R)CLK$(num)Delay-SP") {
  field(DESC, "CLK$(num) trigger delay time")
  field(VAL, "0")
  field(DRVH, "17000000")
  field(DRVL, "0")
  field(PREC, "3")
  field(EGU, "us")
  field(FLNK, "$(P)$(R)CLK$(num)DelayTimeCalc")
}

record(calc, "$(P)$(R)CLK$(num)Delay-RB") {
  field(INPA, "$(P)$(R)CLK$(num)DelayRaw-RB")
  field(INPB, "$(P)$(R)FPGAClk-Mon")
  field(PREC, "3")
  field(DESC, "CLK$(num) delay time RBV")
  field(EGU, "us")
  field(CALC, "A/B*1000000")
}

record(calcout, "$(P)$(R)CLK$(num)DelayTimeCalc") {
  field(DESC, "CLK$(num) trigger delay calc")
  field(INPA, "$(P)$(R)CLK$(num)Delay-SP")
  field(INPB, "$(P)$(R)FPGAClk-Mon")
  field(CALC, "CEIL(A*(B/1000000))-A*(B/1000000)<0.5?CEIL(A*(B/1000000)):FLOOR(A*(B/1000000))")
  field(OUT, "$(P)$(R)CLK$(num)DelayRaw-SP PP")
  field(SDIS, "$(P)$(R)CLK$(num)DelayUpdate.PACT")
}

record(calcout, "$(P)$(R)CLK$(num)DelayUpdate") {
  field(DESC, "CLK$(num) trigger delay update")
  field(INPA, "$(P)$(R)CLK$(num)DelayRaw-SP")
  field(INPB, "$(P)$(R)FPGAClk-Mon CPP")
  field(CALC, "A/B*1000000")
  field(OUT, "$(P)$(R)CLK$(num)Delay-SP PP")
}

record(longout, "$(P)$(R)CLK$(num)DelayRaw-SP") {
  field(DESC, "CLK$(num) trigger delay")
  field(DRVH, "2147483647")
  field(DRVL, "0")
  field(EGU, "evt_T")
  field(DTYP, "stream")
  field(OUT, "@timing.proto evre_clk_set($(P),$(R),$(num)) $(PORT)")
  field(FLNK, "$(P)$(R)CLK$(num)DelayRaw-RB")
}

record(longin, "$(P)$(R)CLK$(num)DelayRaw-RB") {
  field(ASG, "Reserved")
  field(DESC, "CLK$(num) delay RBV")
  field(EGU, "evt_T")
  field(DTYP, "stream")
  field(INP, "@timing.proto evre_clk_get($(P),$(R),$(num)) $(PORT)")
  field(FLNK, "$(P)$(R)CLK$(num)Delay-RB")
}

record(bo, "$(P)$(R)CLK$(num)State-Sel") {
  field(DESC, "CLK$(num) enable")
  field(MASK, "1")
  field(ZNAM, "Dsbl")
  field(ONAM, "Enbl")
  field(FLNK, "$(P)$(R)CLK$(num)RegAByte3")
  field(PINI, YES)
}

record(bi, "$(P)$(R)CLK$(num)State-Sts") {
 field(ASG, "Reserved")
  field(DESC, "CLK$(num) enable status")
  field(ZNAM, "Dsbl")
  field(ONAM, "Enbl")
  field(INP, "$(P)$(R)CLK$(num)RegAByte3RBV.B7")
}

record(bo, "$(P)$(R)CLK$(num)Polarity-Sel") {
  field(DESC, "CLK$(num) polarity")
  field(MASK, "1")
  field(ZNAM, "Normal")
  field(ONAM, "Inverse")
  field(FLNK, "$(P)$(R)CLK$(num)RegAByte3")
}

record(bi, "$(P)$(R)CLK$(num)Polarity-Sts") {
  field(ASG, "Reserved")
  field(DESC, "CLK$(num) polarity status")
  field(ZNAM, "Normal")
  field(ONAM, "Inverse")
  field(INP, "$(P)$(R)CLK$(num)RegAByte3RBV.B6")
  field(FLNK, "$(P)$(R)CLK$(num)State-Sts")
}

record(calcout, "$(P)$(R)CLK$(num)RegAByte3") {
  field(ASG, "Reserved")
  field(DESC, "CLK$(num) download EN, POL")
  field(DTYP, "stream")
  field(INPA, "$(P)$(R)CLK$(num)State-Sel.RVAL")
  field(INPB, "$(P)$(R)CLK$(num)Polarity-Sel.RVAL")
  field(CALC, "(A<<7)|(B<<6)")
  field(OUT, "@timing.proto evre_clk_set($(P),$(R),$(num)) $(PORT)")
}

record(mbbiDirect, "$(P)$(R)CLK$(num)RegAByte3RBV") {
  field(ASG, "Reserved")
  field(DESC, "CLK$(num) enable, pol RBV")
  field(NOBT, "8")
  field(SCAN, "I/O Intr")
  field(DTYP, "stream")
  field(INP, "@timing.proto evre_clk_enpoltime$(num)RBV_intr $(PORT)")
}

record(longin, "$(P)$(R)CLK$(num)EvtCnt-Mon") {
  field(ASG, "Reserved")
  field(DESC, "Event count received")
  field(SCAN, "I/O Intr")
  field(DTYP, "stream")
  field(INP, "@timing.proto evre_clk_count$(num)_intr $(PORT)")
}

record(calc, "$(P)$(R)cmd_clk_set$(num)") {
  field(ASG, "Reserved")
  field(DESC, "Command code to write to CLK$(num)")
  field(PINI, "1")
  field(A, "$(num)")
  field(B, "0x65")
  field(CALC, "B + A") # (0x65 + num(in range 00 to 02))
}

record(calc, "$(P)$(R)cmd_clk_get$(num)") {
  field(ASG, "Reserved")
  field(DESC, "Command code to read CLK$(num)")
  field(PINI, "1")
  field(A, "$(num)")
  field(B, "0xA5")
  field(CALC, "B + A") # (0xA9 + num(in range 00 to 02))
}

